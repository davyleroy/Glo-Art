# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
BRAND_NAME=Kaleido
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,fr,rw
DEFAULT_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,EUR,GBP,RWF,KES,NGN,GHS,ZAR

# ---------------------------------------------------------------------------
# Database (local docker-compose values)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://kaleido:kaleido@localhost:5432/kaleido?schema=public
DIRECT_URL=postgresql://kaleido:kaleido@localhost:5432/kaleido?schema=public

# ---------------------------------------------------------------------------
# Auth (Auth.js v5)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-in-dev-and-definitely-in-prod
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# For AES-256-GCM encryption of TOTP secrets (32 bytes base64)
FIELD_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Providers (select which to use; mocks default so dev works offline)
# ---------------------------------------------------------------------------
PAYMENT_PROVIDERS_ENABLED=mock
PAYMENT_PROVIDER_DEFAULT=mock
PAYMENT_MOCK_ENABLED=true
STORAGE_PROVIDER=local
EMAIL_PROVIDER=smtp
REALTIME_PROVIDER=memory
AI_PROVIDER=mock
SEARCH_PROVIDER=postgres
FX_PROVIDER=static
SCAN_PROVIDER=mock
PUSH_PROVIDER=log
ASSET3D_PROVIDER=mock

# ---------------------------------------------------------------------------
# Stripe (sandbox, leave blank until credentials provided)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# ---------------------------------------------------------------------------
# Flutterwave (sandbox, leave blank until credentials provided)
# ---------------------------------------------------------------------------
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
FLW_WEBHOOK_SECRET_HASH=

# ---------------------------------------------------------------------------
# Storage (defaults to local MinIO from docker-compose)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_PUBLIC=kaleido-public
S3_BUCKET_PRIVATE=kaleido-private
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123

# ---------------------------------------------------------------------------
# Email (defaults to MailHog SMTP from docker-compose)
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Kaleido <no-reply@kaleido.local>"
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Realtime / Jobs / Cache
# ---------------------------------------------------------------------------
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
EMBEDDINGS_PROVIDER_KEY=
AI_DAILY_QUOTA_PER_USER=20

# ---------------------------------------------------------------------------
# Web push
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Unity
# ---------------------------------------------------------------------------
UNITY_BUILD_BASE_URL=
UNITY_ALLOWED_ORIGIN=http://localhost:3000
VR_TOKEN_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Business rules
# ---------------------------------------------------------------------------
COMMISSION_BPS=1200
BUYER_FEE_BPS=300
ESCROW_AUTO_RELEASE_DAYS=3
DISPUTE_WINDOW_DAYS=7
AUCTION_ANTISNIPE_WINDOW_SEC=120
AUCTION_ANTISNIPE_EXTEND_SEC=120
AUCTION_PAYMENT_DUE_HOURS=48

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
FEATURE_PHYSICAL_CHECKOUT=false
FEATURE_CRYPTO_PAYMENTS=false
FEATURE_AI=true
FEATURE_VR=true
FEATURE_PROXY_BIDDING=false
AUTO_PUBLISH_TRUSTED=true

# ---------------------------------------------------------------------------
# Observability / bot protection
# ---------------------------------------------------------------------------
SENTRY_DSN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
LOG_LEVEL=info

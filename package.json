{
  "name": "kaleido",
  "private": true,
  "version": "0.0.0",
  "description": "Global art marketplace with AR/VR gallery integration (Kaleido / Glo-Art)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @kaleido/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @kaleido/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @kaleido/web test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:up": "docker compose up -d postgres mailhog minio redis",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @kaleido/web prisma migrate dev",
    "db:seed": "pnpm --filter @kaleido/web prisma db seed",
    "db:reset": "pnpm --filter @kaleido/web prisma migrate reset --force"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8"
  }
}
